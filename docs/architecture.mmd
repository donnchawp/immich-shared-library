---
config:
  theme: default
  flowchart:
    nodeSpacing: 30
    rankSpacing: 40
    padding: 15
---
flowchart TD
    %% ── Configuration ──
    YAML["fa:fa-file config.yaml<br/>SyncJob definitions"] --> A
    ENV["fa:fa-cog .env / env vars<br/>DB creds, API key"] --> A

    %% ── Startup ──
    A[Load configuration] --> B[Wait for Immich health check<br/><i>GET /api/server/ping</i>]
    B --> C[Init asyncpg pool<br/><i>min=2, max=10</i>]
    C --> D[Create tracking tables<br/><i>_face_sync_asset_map<br/>_face_sync_meta<br/>_face_sync_skipped</i>]
    D --> E[Validate Immich schema]
    E --> CG[Validate cluster group<br/><i>every configured user shares<br/>one clusterGroupId</i>]
    CG --> F[Validate user & library IDs]
    F --> G[Start TCP health server :8080]
    G --> LOOP

    %% ── Main Loop ──
    LOOP{{"sync_loop()<br/>sleep N seconds"}}
    LOOP -->|each cycle| P1_START

    %% ── Phase 1: Asset Sync ──
    P1_START["Phase 1 · Asset Sync<br/><i>per SyncJob, batches of 500</i>"]
    P1_START --> P1a[Find unsynced source assets<br/><i>JOIN asset_job_status + smart_search</i>]
    P1a --> P1b[Filter duplicate filenames<br/><i>same name + dateTimeOriginal</i>]
    P1b --> P1c[SAVEPOINT per asset]
    P1c --> P1d[INSERT target asset<br/><i>remapped paths</i>]
    P1d --> P1e[Copy EXIF + hardlink thumbnails]
    P1e --> P1f[Copy CLIP embedding]
    P1f --> P1g[Copy faces + face embeddings<br/><i>personGroupId copied verbatim</i>]
    P1g --> P1h[Ensure target person row exists<br/><i>ensure_target_person;<br/>hardlink thumbnail if new</i>]
    P1h --> P1i[Record mapping in<br/>_face_sync_asset_map]
    P1i --> P1_END{More assets?}
    P1_END -->|yes| P1c
    P1_END -->|no| ALB

    %% ── Phase 1b: Album ──
    ALB["Phase 1b · Album Sync<br/><i>per job with album_id</i>"]
    ALB --> ALB1[INSERT into album_asset<br/><i>ON CONFLICT DO NOTHING</i>]
    ALB1 --> ALB2[Backfill previously synced assets]
    ALB2 --> P2_START

    %% ── Phase 2: Incremental Face Sync ──
    P2_START["Phase 2 · Incremental Face Sync"]
    P2_START --> P2a[Find asset_face rows where<br/>updatedAt > synced_at watermark]
    P2a --> P2b[Copy new/changed faces<br/><i>bounding-box dedup</i>]
    P2b --> P2c[Bump synced_at watermark]
    P2c --> P3_START

    %% ── Phase 3: Person Metadata ──
    P3_START["Phase 3 · Person Metadata Sync"]
    P3_START --> P3a[Sync person names<br/><i>fills empty names only,<br/>never overwrites</i>]
    P3a --> P3b[Hardlink missing person thumbnails<br/><i>fill-only</i>]
    P3b --> P4_START
    P3_NOTE["isHidden is NOT synced<br/><i>per-user; inherited once at person creation</i>"]
    P3_START -.-> P3_NOTE

    %% ── Phase 4: Cleanup ──
    P4_START["Phase 4 · Cleanup"]
    P4_START --> P4a[Detect deleted/trashed source assets<br/><i>LEFT JOIN</i>]
    P4a --> P4b[Remove thumbnail hardlinks<br/><i>files deleted before DB rows</i>]
    P4b --> P4c[DELETE target asset<br/><i>CASCADE to child tables</i>]
    P4c --> P4d[Reassign target faces to source personGroupId<br/><i>bounding-box match; source authoritative</i>]
    P4d --> P4f[Delete orphaned target persons]
    P4f --> LOOP

    %% ── External Systems ──
    P1d -..->|INSERT| PG[(Postgres<br/>Immich DB)]
    P1e -..->|os.link| FS[("Filesystem<br/>/data/thumbs/")]
    P4b -..->|unlink| FS
    P4c -..->|DELETE CASCADE| PG

    %% ── Styles ──
    style P1_START fill:#2d6b2d,color:#fff,stroke:#4a7a4a
    style ALB fill:#2d6b6b,color:#fff,stroke:#4a7a7a
    style P2_START fill:#6b6b2d,color:#fff,stroke:#7a7a4a
    style P3_START fill:#6b4a2d,color:#fff,stroke:#7a5a4a
    style P4_START fill:#6b2d2d,color:#fff,stroke:#7a4a4a
    style LOOP fill:#336,color:#fff,stroke:#669
    style PG fill:#336,color:#fff,stroke:#669
    style FS fill:#363,color:#fff,stroke:#696
